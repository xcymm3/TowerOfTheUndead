{
  "name": "tower-of-the-undead",
  "packageManager": "pnpm@11.19.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-runtime.mjs && vite",
    "build": "node scripts/build-runtime.mjs && tsc -b && vite build",
    "build:runtime": "node scripts/build-runtime.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src scripts tests",
    "test": "node scripts/build-runtime.mjs && node scripts/build-reference.mjs && node scripts/verify-source.mjs && node tests/runtime.mjs",
    "test:runtime": "node scripts/verify-source.mjs && node tests/runtime.mjs",
    "test:production": "node tests/production.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
